# Optional hosted judges. EvalBench runs fully offline without any of these.
# Select a judge with EVALBENCH_JUDGE=local:<hf-id> | openai:<model> | anthropic:<model>
EVALBENCH_JUDGE=local:Qwen/Qwen2.5-0.5B-Instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Torch threads used for local generation (default: a quarter of the cores)
EVALBENCH_THREADS=3
# Force a device for generation and judging (default: cuda when available, else cpu)
# EVALBENCH_DEVICE=cpu
